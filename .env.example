# Copy this file to .env.local and fill in your own values, or run `npm run setup`
# for an interactive prompt that writes .env.local for you.

# Required: the Google Sheet that holds your program data. Copy the template
# at https://docs.google.com/spreadsheets/d/1sO8OVoDH1I2nAPeJmwjzBdaYrIPsjWEOE6fVRXheOYU/edit
# (File > Make a copy), share it so "Anyone with the link" can view, then paste
# its ID here (the long string in its URL between /d/ and /edit).
NEXT_PUBLIC_SHEET_ID=
NEXT_PUBLIC_SHEET_TAB=Sheet1

# Optional branding. If left unset, the site falls back to its built-in defaults.
NEXT_PUBLIC_SITE_TITLE=Enrichment Programs
NEXT_PUBLIC_SITE_HEADING=Enrichment Programs
NEXT_PUBLIC_SITE_DESCRIPTION=Browse enrichment programs and opportunities.
NEXT_PUBLIC_LOGO_PATH=
NEXT_PUBLIC_LOGO_ALT=
NEXT_PUBLIC_RESOURCE_LINK_LABEL=
NEXT_PUBLIC_RESOURCE_LINK_URL=
NEXT_PUBLIC_FONT_STYLESHEET_URL=
